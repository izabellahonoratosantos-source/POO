5. Projeto integrando os 4 pilares

abstract class Pessoa {
  constructor(public nome: string) {}

  abstract exibirInformacoes(): void; 
}

class Aluno extends Pessoa {
  private notas: number[] = [];

  constructor(nome: string, public curso: string) {
    super(nome);
  }

  adicionarNota(nota: number) {
    if (nota < 0 || nota > 10) throw new Error("Nota inválida");
    this.notas.push(nota);
  }

  getMedia(): number {
    if (this.notas.length === 0) return 0;
    return this.notas.reduce((a, b) => a + b, 0) / this.notas.length;
  }

  exibirInformacoes(): void {
    console.log(`[ALUNO] ${this.nome} - Curso: ${this.curso} - Média: ${this.getMedia().toFixed(1)}`);
  }
}

class Professor extends Pessoa {
  private salario: number;

  constructor(nome: string, public disciplina: string, salario: number) {
    super(nome);
    this.salario = salario;
  }

  getSalario(): number {
    return this.salario;
  }

  exibirInformacoes(): void {
    console.log(`[PROFESSOR] ${this.nome} - Disciplina: ${this.disciplina}`);
  }
}


const aluno = new Aluno("izabella", "ADS");
aluno.adicionarNota(8);
aluno.adicionarNota(9);

const professor = new Professor("Maria", "POO", 5000);

const pessoas: Pessoa[] = [aluno, professor];
pessoas.forEach(p => p.exibirInformacoes()); 
