function dividir(a: number, b: number): number {
  if (b === 0) {
    throw new Error("Não é possível dividir por zero");
  }
  return a / b;
}

try {
  console.log(dividir(10, 0));
} catch (erro) {
  console.error("Ocorreu um erro:", (erro as Error).message);
}


function converterParaNumero(valor: string): number {
  const numero = Number(valor);
  if (isNaN(numero)) {
    throw new Error(`Valor "${valor}" não é um número válido`);
  }
  return numero;
}

try {
  // Tenta executar um código que pode falhar
  const resultado = converterParaNumero("abc");
  console.log("Resultado:", resultado);
} catch (error) {
  // Se falhar, cai aqui
  console.error("Erro capturado:", (error as Error).message);
}


Funcionamento:
O try tenta executar. Se tudo der certo, o catch é ignorado.
Se um throw for lançado dentro do try, a execução para imediatamente e vai para o catch.

