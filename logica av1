5. Aplicação prática - Transferência Bancária



class ValorInvalidoError extends Error {
  constructor() {
    super("O valor da transferência deve ser maior que zero.");
    this.name = "ValorInvalidoError";
  }
}

class SaldoInsuficienteError extends Error {
  constructor(saldo: number, valor: number) {
    super(`Saldo insuficiente! Saldo: R$${saldo} | Tentativa: R$${valor}`);
    this.name = "SaldoInsuficienteError";
  }
}


function transferir(saldo: number, valor: number): number {
  if (valor <= 0) {
    throw new ValorInvalidoError(); // Lança exceção se valor <= 0
  }

  if (valor > saldo) {
    throw new SaldoInsuficienteError(saldo, valor); // Lança exceção se valor > saldo
  }

  
  return saldo - valor;
}



let saldoAtual = 1000;

console.log("TESTE 1 - Valor inválido (menor ou igual a zero)");
try {
  saldoAtual = transferir(saldoAtual, 0);
} catch (error) {
  console.log(`Erro tratado: ${(error as Error).message}`);
}

console.log("\nTESTE 2 - Saldo insuficiente");
try {
  saldoAtual = transferir(saldoAtual, 1500);
} catch (error) {
  console.log(`Erro tratado: ${(error as Error).message}`);
}

console.log("\nTESTE 3 - Transferência válida");
try {
  saldoAtual = transferir(saldoAtual, 300);
  console.log(`Sucesso! Novo saldo: R$${saldoAtual}`);
} catch (error) {
  console.log(`Erro tratado: ${(error as Error).message}`);
}
